<?xml version="1.0"?>
<robot name="robot_con_pinza">

  <!-- ============ MATERIALES (COLORES) ============ -->
  <material name="base_material">
    <color rgba="0.3 0.3 0.3 1"/>  <!-- Gris oscuro -->
  </material>
  
  <material name="brazo1_material">
    <color rgba="0.2 0.6 0.8 1"/>  <!-- Azul celeste -->
  </material>
  
  <material name="brazo2_material">
    <color rgba="0.9 0.5 0.1 1"/>  <!-- Naranja -->
  </material>
  
  <material name="pinza_material">
    <color rgba="0.8 0.2 0.2 1"/>  <!-- Rojo -->
  </material>
  
  <material name="dedo_material">
    <color rgba="0.9 0.9 0.9 1"/>  <!-- Blanco/gris claro -->
  </material>
  
  <material name="efector_material">
    <color rgba="0.0 0.8 0.0 1"/>  <!-- Verde -->
  </material>

  <!-- ============ LINK 0: BASE ============ -->
  <link name="base_link">
    <visual>
      <geometry>
        <cylinder length="0.15" radius="0.25"/>
      </geometry>
      <origin xyz="0 0 0.075"/>
      <material name="base_material"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.15" radius="0.25"/>
      </geometry>
      <origin xyz="0 0 0.075"/>
    </collision>
  </link>

  <!-- ============ JOINT 1: BASE -> BRAZO1 ============ -->
  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="brazo1_link"/>
    <origin xyz="0 0 0.15"/>
    <axis xyz="0 0 1"/>  <!-- Gira alrededor del eje Z (vertical) -->
    <limit lower="-3.14" upper="3.14" effort="100" velocity="1.0"/>
  </joint>

  <link name="brazo1_link">
    <visual>
      <geometry>
        <cylinder length="0.3" radius="0.05"/>
      </geometry>
      <origin xyz="0 0 0.15"/>
      <material name="brazo1_material"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.3" radius="0.05"/>
      </geometry>
      <origin xyz="0 0 0.15"/>
    </collision>
  </link>

  <!-- ============ JOINT 2: BRAZO1 -> BRAZO2 ============ -->
  <joint name="joint_2" type="revolute">
    <parent link="brazo1_link"/>
    <child link="brazo2_link"/>
    <origin xyz="0 0 0.3"/>
    <axis xyz="0 1 0"/>  <!-- Gira alrededor del eje Y (horizontal) -->
    <limit lower="-1.57" upper="1.57" effort="100" velocity="1.0"/>
  </joint>

  <link name="brazo2_link">
    <visual>
      <geometry>
        <cylinder length="0.25" radius="0.04"/>
      </geometry>
      <origin xyz="0 0 0.125"/>
      <material name="brazo2_material"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.25" radius="0.04"/>
      </geometry>
      <origin xyz="0 0 0.125"/>
    </collision>
  </link>

  <!-- ============ JOINT GRIPPER: BRAZO2 -> PINZA ============ -->
  <joint name="joint_gripper" type="revolute">
    <parent link="brazo2_link"/>
    <child link="pinza_link"/>
    <origin xyz="0 0 0.25"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.78" upper="0.78" effort="50" velocity="0.5"/>
  </joint>

  <link name="pinza_link">
    <visual>
      <geometry>
        <box size="0.08 0.06 0.04"/>
      </geometry>
      <origin xyz="0 0 0.02"/>
      <material name="pinza_material"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.08 0.06 0.04"/>
      </geometry>
      <origin xyz="0 0 0.02"/>
    </collision>
  </link>

  <!-- ============ DEDO IZQUIERDO ============ -->
  <joint name="joint_dedo_izq" type="prismatic">
    <parent link="pinza_link"/>
    <child link="dedo_izq_link"/>
    <origin xyz="0 0.03 0.04"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="0.02" effort="10" velocity="0.1"/>
  </joint>

  <link name="dedo_izq_link">
    <visual>
      <geometry>
        <box size="0.02 0.01 0.03"/>
      </geometry>
      <material name="dedo_material"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.02 0.01 0.03"/>
      </geometry>
    </collision>
  </link>

  <!-- ============ DEDO DERECHO ============ -->
  <joint name="joint_dedo_der" type="prismatic">
    <parent link="pinza_link"/>
    <child link="dedo_der_link"/>
    <origin xyz="0 -0.03 0.04"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0" upper="0.02" effort="10" velocity="0.1"/>
  </joint>

  <link name="dedo_der_link">
    <visual>
      <geometry>
        <box size="0.02 0.01 0.03"/>
      </geometry>
      <material name="dedo_material"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.02 0.01 0.03"/>
      </geometry>
    </collision>
  </link>

  <!-- ============ EFECTOR FINAL (Punta verde) ============ -->
  <joint name="joint_efector" type="fixed">
    <parent link="pinza_link"/>
    <child link="efector_link"/>
    <origin xyz="0 0 0.04"/>
  </joint>

  <link name="efector_link">
    <visual>
      <geometry>
        <sphere radius="0.015"/>
      </geometry>
      <material name="efector_material"/>
    </visual>
  </link>

</robot>